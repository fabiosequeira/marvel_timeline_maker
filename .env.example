# ---------------------------------------------------------------------------
# Database (used directly by docker-compose.yml to build DATABASE_URL — you
# normally don't need to touch DATABASE_URL itself when running via Docker)
# ---------------------------------------------------------------------------
POSTGRES_USER=timeline
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=timeline

# Only needed if you run the app outside Docker (e.g. `npm run dev` against
# a local Postgres). When using docker-compose, this is generated for you.
# DATABASE_URL=postgresql://timeline:password@localhost:5432/timeline

# ---------------------------------------------------------------------------
# Metadata providers — leave blank to disable a provider. TMDB is required
# for the full feature set (movies, shows, and seasons). Get a free key at
# https://www.themoviedb.org/settings/api
# ---------------------------------------------------------------------------
TMDB_API_KEY=

# Optional. TVDB v4 API key: https://thetvdb.com/api-information
TVDB_API_KEY=
# Only needed if your TVDB key requires a subscriber PIN.
TVDB_PIN=

# Optional. OMDb API key (IMDb-id based, movies/shows only, no seasons):
# https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Marvel Timeline
APP_PORT=3000

# ---------------------------------------------------------------------------
# Admin authentication — required. Protects /admin, /settings, and every
# mutating API route. The public /timeline stays read-only without these.
# ---------------------------------------------------------------------------
AUTH_USERNAME=admin
# Simplest option — plain text password (fine for a self-hosted app behind
# your own network/reverse proxy, but a hash is more defense-in-depth):
AUTH_PASSWORD=change-me
# Alternative: set a bcrypt hash instead of AUTH_PASSWORD (takes precedence
# if both are set). Generate one with:
#   docker run --rm node:20-alpine node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# AUTH_PASSWORD_HASH=
